{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.3",
  "description": "Kaijage Hardware and Cosmetics point-of-sale system",
  "author": "Aelyn Technologies",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wasley06/kaijage.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs next dev",
    "build": "node scripts/build.mjs",
    "app:dev": "vite --config vite.config.ts",
    "app:build": "node scripts/build-icons.mjs && vite build --config vite.config.ts && node scripts/build-electron-main.mjs",
    "app:preview": "vite preview --config vite.config.ts",
    "desktop:package": "npm run app:build && electron-builder --publish never",
    "mobile:sync": "cap sync",
    "start": "node scripts/run.mjs next start",
    "format": "oxfmt",
    "generate:importmap": "node scripts/run.mjs payload generate:importmap",
    "generate:types": "node scripts/run.mjs payload generate:types",
    "payload": "node scripts/run.mjs payload"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@payloadcms/figma": "1.0.0-beta.1",
    "@payloadcms/next": "4.0.0-beta.6",
    "@payloadcms/plugin-cloud-storage": "4.0.0-beta.6",
    "@payloadcms/plugin-mcp": "4.0.0-beta.6",
    "@payloadcms/richtext-lexical": "4.0.0-beta.6",
    "@payloadcms/translations": "4.0.0-beta.6",
    "@payloadcms/ui": "4.0.0-beta.6",
    "electron-updater": "6.8.11",
    "graphql": "^16.8.1",
    "html-react-parser": "^5.2.10",
    "monaco-editor": "0.55.1",
    "next": "16.4.2",
    "payload": "4.0.0-beta.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "0.28.2",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "electron-winstaller"
    ]
  },
  "main": "assets/generated/electron-main.cjs",
  "build": {
    "appId": "com.aelyn.kaijagepos",
    "productName": "Kaijage POS",
    "asar": true,
    "directories": {
      "output": "artifacts"
    },
    "artifactName": "KaijagePOS-${version}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "assets/generated/**/*",
      "dist/app/**/*",
      "package.json",
      "!node_modules/**",
      "!electron/runtime/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Wasley06",
        "repo": "kaijage",
        "releaseType": "release"
      }
    ],
    "electronUpdaterCompatibility": ">=6.8.11",
    "win": {
      "icon": "assets/generated/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "assets/generated/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    }
  }
}
